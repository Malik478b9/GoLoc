{
  "expo": {
    "name": "GoLoc Captain",
    "slug": "goloc-captain",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "goloc-captain",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6EFE1",
    "ios": {
      "bundleIdentifier": "in.goloc.captain",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GoLoc shares your location with your traveler and our safety team while a trip is active.",
        "NSPhotoLibraryUsageDescription": "Choose photos and videos for your profile, trips and reels.",
        "NSCameraUsageDescription": "Take photos of documents and record reels.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Connects to the GoLoc server on your network during development."
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.goloc.captain",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E2B2C",
          "imageWidth": 150,
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GoLoc shares your location with your traveler and our safety team while a trip is active."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos for your profile, trips and reels.",
          "cameraPermission": "Take photos of documents and record reels."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B8FC9",
          "icon": "./assets/notification-icon.png"
        }
      ],
      ["expo-audio", { "microphonePermission": "GoLoc uses the microphone so you can speak instead of typing." }]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "GoLoc Captain",
      "shortName": "GoLoc Captain",
      "themeColor": "#0E2B2C",
      "backgroundColor": "#F6EFE1",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9eb6fcfe-df0c-4bfa-b6f4-8717e274330b"
      }
    },
    "owner": "goloc.in",
    "icon": "./assets/icon.png"
  }
}
