# Copy to .env for local development:  cp .env.example .env
# In production set these as real environment variables on your host.

# --- Core -----------------------------------------------------------------
# True only on your laptop. Production must be False (the default).
DEBUG=True
# Production: a long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Production: your API domain(s), comma-separated, e.g. api.goloc.in
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Web apps allowed to call the API from a browser (comma-separated, with scheme).
# Dev default covers localhost:5174/5175/5176. Production e.g.:
# CORS_ALLOWED_ORIGINS=https://goloc.in,https://captain.goloc.in,https://admin.goloc.in
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# sqlite for quick local runs; postgresql for production.
DATABASE_ENGINE=sqlite
POSTGRES_DB=goloc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# --- Cache / rate limits ---------------------------------------------------
# Production with more than one worker/server: point at Redis so limits are shared.
REDIS_URL=

# --- Sessions -------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# --- OTP login ------------------------------------------------------------
# console = print code in the server log (dev only). twilio_verify = real SMS.
OTP_PROVIDER=console
# Dev only: make every code this value (e.g. 123456). Ignored when DEBUG=False.
OTP_DEV_FIXED_CODE=
# Dev only: return the code in the API response so the apps can show it. Ignored when DEBUG=False.
OTP_EXPOSE_CODE_IN_RESPONSE=True
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
OTP_DEFAULT_COUNTRY_CODE=91

# Twilio Verify — https://console.twilio.com → Verify → Services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# --- Marketplace -----------------------------------------------------------
# Empty = links (payment page, trip share) use the host the app called, so phones on your Wi-Fi work.
PUBLIC_BASE_URL=
# fake = full checkout flow with a test page, no keys, no money. razorpay = real (test or live) keys.
PAYMENT_GATEWAY=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# log = print pushes to the console; expo = send through Expo's push service.
PUSH_PROVIDER=log
PLATFORM_COMMISSION_PERCENT=18
INSURANCE_FEE_PER_GUEST_DAY=49
INSURANCE_PREMIUM_PER_GUEST_DAY=29

# --- Background jobs -------------------------------------------------------
# With REDIS_URL set, Celery uses it; without, jobs run inline (fine on a laptop).
# Run them:  celery -A goloc worker -l info   and   celery -A goloc beat -l info

# --- Media -----------------------------------------------------------------
# Local disk by default (media/ public, private_media/ for KYC). Set AWS_* for S3 / R2.
AWS_STORAGE_BUCKET_NAME=
