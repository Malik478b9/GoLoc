# Copy to .env.production, fill in, then:
#   docker compose --env-file .env.production up -d --build
# Never commit the real file. Keep comments on their own lines (no inline comments).

# ---- Core
DEBUG=False
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=api.goloc.in
CSRF_TRUSTED_ORIGINS=https://api.goloc.in
PUBLIC_BASE_URL=https://api.goloc.in
LOG_LEVEL=INFO
# gunicorn processes (about one per CPU core), each with GUNICORN_THREADS threads
WEB_CONCURRENCY=3
GUNICORN_THREADS=4

# ---- Database (docker-compose runs Postgres for you)
POSTGRES_DB=goloc
POSTGRES_USER=goloc
POSTGRES_PASSWORD=
# "require" for a managed database
POSTGRES_SSLMODE=disable

# ---- Login (SMS OTP via Twilio Verify; India needs DLT registration)
OTP_PROVIDER=twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---- Payments
# Razorpay test keys (rzp_test_...) work end to end without real money; switch to live keys at launch.
# Webhook URL: https://api.goloc.in/api/v1/payments/webhooks/razorpay/  (events: payment.captured, payment.failed)
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Staging without Razorpay keys only:
# PAYMENT_GATEWAY=fake
# ALLOW_FAKE_PAYMENTS=True

# ---- Push notifications (Expo push service, no keys needed)
PUSH_PROVIDER=expo

# ---- Media storage
# Leave empty to keep uploads on the local volume (served by nginx).
# For S3 or Cloudflare R2 fill these in (R2 endpoint: https://<account>.r2.cloudflarestorage.com).
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Marketplace rules (defaults shown)
PLATFORM_COMMISSION_PERCENT=18
INSURANCE_FEE_PER_GUEST_DAY=49
INSURANCE_PREMIUM_PER_GUEST_DAY=29
REQUEST_EXPIRY_HOURS=24
PAYMENT_WINDOW_MINUTES=120
CAPTAIN_INACTIVITY_HOLD_DAYS=30
MIN_PAYOUT_AMOUNT=500
